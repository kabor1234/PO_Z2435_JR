<Window x:Class="projektWypozyczalnia.AddingToStock.AddEquipmentToStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:projektWypozyczalnia"
        mc:Ignorable="d"
        Title="AddToStockWindow" Height="200" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None">
        
    
    <StackPanel Margin="10">
        <TextBlock TextAlignment="Center">Dodawanie osprzętu</TextBlock>
        <TextBlock Margin="0,15,0,0">Nazwa osprzętu:</TextBlock>
        <ComboBox x:Name="EquipmentNameComboBox" Margin="0,5,0,0"></ComboBox>
        <TextBlock Margin="0,15,0,0">Ilość:</TextBlock>
        <TextBox x:Name="AmountOfEquipmentTextBox" Margin="0,5,0,0"></TextBox>
        
        <StackPanel Orientation="Horizontal" Margin="0,25,0,20">
            <Button x:Name="AddNewEquipmentItem"
                    Content = "Dodaj nowy osprzęt"
                    Height="20"
                    Margin="0,0,175,0"
                    Click = "AddNewEquipment_OnClick"/>
            <Button x:Name="Cancel"
                    Content="Anuluj" 
                    Height="20"
                    Margin="0,0,8,0"
                    Click="Cancel_OnClick"/>
            <Button x:Name="AddEquipmentToStockButton" 
                    Margin="0,0,10,0"
                    Content="Dodaj" 
                    Height="20"
                    Click="AddEquipmentToStock_onClick"/>
        </StackPanel>
        
    </StackPanel>
</Window>
