<Window x:Class="projektWypozyczalnia.RentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:projektWypozyczalnia="clr-namespace:projektWypozyczalnia"
        mc:Ignorable="d"
        Title="Wypożycz" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None">
    <Grid Margin="10">
       
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" HorizontalAlignment="Center"><TextBlock>Wypożycz</TextBlock></StackPanel>
        
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                    <TextBlock>Dane kontrahenta</TextBlock>
                </StackPanel>
                <StackPanel Margin="0,15,0,0">
                    <TextBlock Text="Nazwa firmy:"/>
                    <TextBox x:Name="NameOfCompany" Margin="0,5,0,0"/>
                    <TextBlock Text="NIP:" Margin="0,5,0,0"/>
                    <TextBox x:Name="NumberOfCompany" Margin="0,5,0,0"/>
                    <TextBlock Text="Adres:" Margin="0,5,0,0"/>
                    <TextBox x:Name="AddressOfCompany" Margin="0,5,0,0"/>
                    <TextBlock Text="Kod pocztowy:" Margin="0,5,0,0"/>
                    <TextBox x:Name="PostNumber" Margin="0,5,0,0"/>
                    <TextBlock Text="Poczta:" Margin="0,5,0,0"/>
                    <TextBox x:Name="NameOfPostEstablishment" Margin="0,5,0,0"/>
                </StackPanel>    
                </StackPanel>
            
                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                        <TextBlock Text="Dane do kontaktu"/>
                    </StackPanel>
                    <StackPanel Margin="0,15,0,0">
                        <TextBlock Text="Imię:"/>
                        <TextBox x:Name="ContactPersonName" Margin="0,5,0,0"/>
                        <TextBlock Text="Nazwisko:" Margin="0,5,0,0"/>
                        <TextBox x:Name="ContactPersonSurname" Margin="0,5,0,0"/>
                        <TextBlock Text="Numer telefonu:" Margin="0,5,0,0"/>
                        <TextBox x:Name="ContactPersonPhoneNumber" Margin="0,5,0,0"/>
                        <TextBlock Text="E-mail:" Margin="0,5,0,0"/>
                        <TextBox x:Name="ContactPersonEmail" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <StackPanel Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <TextBlock Text="Termin wynajmu"/>
                </StackPanel>
                <StackPanel Margin="0,15,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0">
                            <Calendar SelectionMode="SingleRange" x:Name="DateSelectionsCalendar" Language="pl-PL"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <TextBox x:Name="CommentsTextBox" 
                                    HorizontalAlignment="Stretch" 
                                    Height="40" 
                                    Foreground="Gray"
                                    Text="Uwagi do wynajmu..."
                                    GotFocus="CommentsTextBox_GotFocused"
                                    LostFocus="CommentsTexbox_LostFocused"/>
                        </StackPanel>
                    </Grid>
                    
                </StackPanel>
                
            </StackPanel>
        </Grid>
        

        <DataGrid Grid.Row="2" x:Name="AddedObjectDataGrid" AutoGenerateColumns="False" CanUserResizeColumns="False" CanUserReorderColumns="False">\
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dodano" Binding="{Binding Added}" Width="*"/>
                <DataGridTextColumn Header="Ilość" Binding="{Binding Amount}" Width="*"/>
                <DataGridTextColumn Header="Cena netto" Binding="{Binding Price}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Row="0">
                <TextBlock Text="Całkowita wartość wynajętego sprzętu:"/>
                <TextBlock Text="Dzienny koszt dzierżawy:"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                <TextBlock x:Name="TotalValueOfEquipment"/>
                <TextBlock x:Name="DailyPriceOfRent"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Button x:Name="AddToRentButton"
                        Content="Dodaj sprzęt"
                        Click="AddItems_OnClick"
                        Height="30"
                        Width="80"/>
            </StackPanel>
            
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="CancelButton"
                        Content="Anuluj"
                        Click="Cancel_OnClick"
                        Margin="0,0,5,0"
                        Height="30"
                        Width="60"/>
                <Button x:Name="RentButton"
                        Content="Wypożycz"
                        Click="Rent_OnClick"
                        Margin="5,0,10,0"
                        Height="30"
                        Width="60"/>
            </StackPanel>
        </Grid>
        
    </Grid>
</Window>
