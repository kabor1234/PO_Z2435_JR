<Window x:Class="projektWypozyczalnia.AddShutteringToStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:projektWypozyczalnia"
        mc:Ignorable="d"
        Title="AddToStockWindow" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        Loaded="StartupAddShutteringToStockWindow">
    
    <StackPanel Margin="10">
        <TextBlock Margin="0,0,0,2">Wybierz, co chcesz dodać:</TextBlock>
        <ComboBox Name="AddShutteringToStockComboBox" Margin="0,0,320,0">
            <ComboBoxItem Name="ShutteringComboBoxItem" Content="Szalunki"/>    
            <ComboBoxItem Name="EquipmentComboBoxItem" Content="Osprzęt"/>
        </ComboBox>
        
    </StackPanel>
</Window>
