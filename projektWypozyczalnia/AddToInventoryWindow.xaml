<Window x:Class="projektWypozyczalnia.AddToInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:projektWypozyczalnia"
        mc:Ignorable="d"
        Title="Dodaj do magazynu" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None">
    <Grid>
        <StackPanel Margin="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                <Button x:Name="ExitFromStock"
                        Content="Wyjdź" 
                        Margin="10,15,0,0"
                        Click="Close_OnClick"/>
                <Button x:Name="AddToStock" 
                        Content="Dodaj do magazynu" 
                        Margin="10,15,0,0"/>
                <Button x:Name="RemoveFromStock"
                        Content="Usuń z magazynu"
                        Margin="10,15,0,0"/>
            </StackPanel>
            
            <StackPanel>
                
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
