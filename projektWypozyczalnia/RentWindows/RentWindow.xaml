<Window x:Class="projektWypozyczalnia.RentWindows.RentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:projektWypozyczalnia="clr-namespace:projektWypozyczalnia"
        mc:Ignorable="d"
        Title="Wypożycz" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Closing="RentWindow_OnClosing">
    <Grid Margin="10">
       
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" HorizontalAlignment="Center"><TextBlock>Wypożycz</TextBlock></StackPanel>
        
        <Grid Grid.Row="1" Margin="0,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                    <TextBlock>Dane kontrahenta</TextBlock>
                </StackPanel>
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Nazwa firmy:"/>
                    <TextBox x:Name="NameOfCompanyTextBox" Margin="0,5,0,0"/>
                    <TextBlock Text="NIP:" Margin="0,5,0,0"/>
                    <TextBox x:Name="NumberOfCompanyTextBox" Margin="0,5,0,0"/>
                    <TextBlock Text="Adres:" Margin="0,5,0,0"/>
                    <TextBox x:Name="AddressOfCompanyTextBox" Margin="0,5,0,0"/>
                    <TextBlock Text="Kod pocztowy (xx-xxx):" Margin="0,5,0,0"/>
                    <TextBox x:Name="PostNumberTextBox" Margin="0,5,0,0"/>
                    <TextBlock Text="Poczta:" Margin="0,5,0,0"/>
                    <TextBox x:Name="NameOfPostEstablishmentTextBox" Margin="0,5,0,0"/>
                    <TextBlock Text="Adres budowy:" Margin="0,5,0,0"/>
                    <TextBox x:Name="AddressOfBuildingTextBox" Margin="0,5,0,0"/>
                    
                </StackPanel>    
                </StackPanel>
            
                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                        <TextBlock Text="Dane do kontaktu"/>
                    </StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,10,0,0">
                            <TextBlock Text="Imię:"/>
                            <TextBox x:Name="ContactPersonNameTextBox" Margin="0,5,0,0"/>
                            <TextBlock Text="Nazwisko:" Margin="0,5,0,0"/>
                            <TextBox x:Name="ContactPersonSurnameTextBox" Margin="0,5,0,0"/>
                            <TextBlock Text="Numer telefonu:" Margin="0,5,0,0"/>
                            <TextBox x:Name="ContactPersonPhoneNumberTextBox" Margin="0,5,0,0"/>
                            <TextBlock Text="E-mail:" Margin="0,5,0,0"/>
                            <TextBox x:Name="ContactPersonEmailTextBox" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,35,0,10">
                            <Button x:Name="ChooseContractorFromAvaible"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    Width="100"
                                    Click="ChooseContractorFromAvaible_OnClick">
                                <TextBlock TextAlignment="Center">Wybierz dane <LineBreak/> kontrahenta</TextBlock>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <StackPanel Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <TextBlock Text="Termin wynajmu"/>
                </StackPanel>
                <StackPanel Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="90"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0">
                            <Calendar SelectionMode="SingleRange" x:Name="DateSelectionsCalendar" Language="pl-PL"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <TextBox x:Name="CommentsTextBox" 
                                    HorizontalAlignment="Stretch" 
                                    Height="80" 
                                    Foreground="Gray"
                                    Text="Uwagi do wynajmu..."
                                    GotFocus="CommentsTextBox_GotFocused"
                                    LostFocus="CommentsTexbox_LostFocused"/>
                        </StackPanel>
                    </Grid>
                    
                </StackPanel>
                
            </StackPanel>
        </Grid>
        

        <DataGrid Grid.Row="2" x:Name="AddedObjectDataGrid" AutoGenerateColumns="False" CanUserResizeColumns="False" CanUserReorderColumns="False" ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dodano" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Ilość" Binding="{Binding Amount}" Width="*" />
                <DataGridTextColumn Header="Cena netto (szt)" Binding="{Binding PricePerUnit}" Width="*" />
                <DataGridTextColumn Header="Całkowita cena netto" Binding="{Binding TotalPrice}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Row="0">
                <TextBlock Text="Całkowita wartość wynajętego sprzętu:"/>
                <TextBlock Text="Dzienny koszt dzierżawy:"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                <TextBlock x:Name="TotalValueOfEquipmentTextBlock"/>
                <TextBlock x:Name="DailyPriceOfRent"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Button x:Name="AddToRentButton"
                        Content="Dodaj sprzęt"
                        Click="AddShutterings_OnClick"
                        Height="30"
                        Width="80"/>
            </StackPanel>
            
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="CancelButton"
                        Content="Anuluj"
                        Click="CancelButton_OnClick"
                        Margin="0,0,5,0"
                        Height="30"
                        Width="60"/>
                <Button x:Name="RentButton"
                        Content="Wypożycz"
                        Click="StartRent_OnClick"
                        Margin="5,0,10,0"
                        Height="30"
                        Width="60"/>
            </StackPanel>
        </Grid>
        
    </Grid>
</Window>
