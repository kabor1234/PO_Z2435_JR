<Window x:Class="projektWypozyczalnia.RentWindows.RentingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Wypożyczenia" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Loaded="ShowEquipmentCheckBox_Unchecked">
    <Grid>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top">
                <Button x:Name="ExitFromRentalWindow"
                        Content="Wyjdź" 
                        Margin="10,15,0,0"
                        Click="Close_OnClick"/>
                <Button x:Name="AddEquipmentToStock" 
                        Content="Wypożycz" 
                        Margin="10,15,0,0"
                        Click="Rent_OnClick"/>
                <Button x:Name="Refresh" 
                        Content="Odśwież" 
                        Margin="10,15,0,0"
                        Click="RefreshWindow_OnClick"/>
                <CheckBox x:Name="ShowEquipmentCheckBox" 
                          Margin="10,17,0,0" 
                          Content="Do zatwierdzenia po terminie"
                          IsChecked="False"
                          Checked="ShowExpiredRentalCheckBox_Checked"
                          Unchecked="ShowExpiredRentalCheckBox_Unchecked"/>
            </StackPanel>
            
            <DataGrid x:Name="StockDataGrid" AutoGenerateColumns="False" Margin="10,50,10,10" IsReadOnly="True" CanUserResizeColumns="False" CanUserResizeRows="False" CanUserReorderColumns="False">
                    <DataGrid.Columns>
                            <DataGridTextColumn Header="Numer umowy" Binding="{Binding ContractNumber}" Width="*"/>
                            <DataGridTextColumn Header="Kontrahent" Binding="{Binding TradePartner}" Width="*"/>
                            <DataGridTextColumn Header="Adres budowy" Binding="{Binding AddressOfBuilding}" Width="*"/>
                            <DataGridTextColumn Header="Początek najmu" Binding="{Binding StartDateRent}" Width="*"/>
                            <DataGridTextColumn Header="Koniec najmu" Binding="{Binding EndDateRent}" Width="*"/>
                    </DataGrid.Columns>
            </DataGrid>
    </Grid>
</Window>
