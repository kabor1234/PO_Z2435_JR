<Window x:Class="projektWypozyczalnia.RentWindows.ChoosingAddingItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:projektWypozyczalnia.RentWindows"
        mc:Ignorable="d"
        Title="ChoosingAddingItemWindow" Height="150" Width="200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize">
        <Border
                BorderBrush="Black"
                BorderThickness="3">
                
                <StackPanel Margin="20" >
        <Button x:Name="Shutterings"
                Margin="0,0,0,10"
                Content="Szalunki"
                Click="ChooseShutterings_OnClick"/>
        <Button x:Name="Equipment"
                Margin="0,10,0, 10"
                Content="Osprzęt"
                Click="ChooseEquipment_OnClick"/>
        
        <Button x:Name="Exit"
                Margin="0,10,0,10"
                Content="Wyjdź"
                Click="Exit_OnClick"/>
        
        </StackPanel>
        </Border>
</Window>
