<Window x:Class="projektWypozyczalnia.RentWindows.ChooseClientForShutteringsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:projektWypozyczalnia.RentWindows"
        mc:Ignorable="d"
        Title="ChooseClientWindow" Height="200" Width="400"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock HorizontalAlignment="Center">Wybierz klienta</TextBlock>
            <ComboBox x:Name="ClientComboBox" VerticalAlignment="Center" Margin="0,15,0,0" SelectionChanged="ChooseClientForShutterings_selectionChanged"></ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Height="40"
                    Width="60"
                    Margin="0,0,10,0"
                    Click="CancelClientForShutteringsButton_OnClick">
                <Button.Content>
                    <TextBlock>
                        Anuluj <LineBreak/> wybór
                    </TextBlock>
                </Button.Content>
            </Button>
            <Button x:Name="AddClient"
                    Height="40"
                    Width="60"
                    Click="AddClientForShutterings_onClick">
                <Button.Content>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                        Zatwierdź <LineBreak/> wybór
                    </TextBlock>
                </Button.Content>
                
            </Button>
        </StackPanel>
    </Grid>
</Window>
