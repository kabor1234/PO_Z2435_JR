<Window x:Class="projektWypozyczalnia.RentWindows.AddEquipmentToRentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:projektWypozyczalnia.RentWindows"
        mc:Ignorable="d"
        Title="AddEquipmentToRentingWindow" Height="240" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None">
        
    
    <StackPanel Margin="10">
        <TextBlock TextAlignment="Center">Dodawanie osprzętu</TextBlock>
        <TextBlock Margin="0,15,0,0">Nazwa osprzętu:</TextBlock>
        <ComboBox x:Name="EquipmentNameComboBox" Margin="0,5,0,0" SelectionChanged="EquipmentNameComboBox_SelectionChanged"/>

        
        <StackPanel>
            <TextBlock Margin="0,10,0,0">Ilość:</TextBlock>
            <TextBox x:Name="AmountOfEquipmentTextBox" Margin="0,5,0,0"></TextBox>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Margin="0,25,0,0" HorizontalAlignment="Right">
            <Button x:Name="Cancel"
                    Content="Anuluj" 
                    Height="20"
                    Margin="0,0,8,0"
                    Click="Cancel_OnClick"/>
            <Button x:Name="AddEquipmentToStockButton" 
                    Margin="0,0,10,0"
                    Content="Dodaj" 
                    Height="20"
                    Click="AddEquipmentToRent_onClick"/>
        </StackPanel>
        
    </StackPanel>
</Window>
