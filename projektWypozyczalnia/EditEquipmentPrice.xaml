<Window x:Class="projektWypozyczalnia.EditEquipmentPrice"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:projektWypozyczalnia"
        mc:Ignorable="d"
        Title="EditEquipmentPrice" Height="200" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Closing="EditEquipmentPriceWindow_OnClosing">
    
    <StackPanel Margin="10">
        <TextBlock TextAlignment="Center">Zmiana ceny osprzętu</TextBlock>
        <TextBlock Margin="0,15,0,0">Nazwa osprzętu:</TextBlock>
        <ComboBox x:Name="EquipmentNameComboBox" Margin="0,5,0,0"></ComboBox>
        <TextBlock Margin="0,15,0,0">Cena (zł):</TextBlock>
        <TextBox x:Name="NewPriceEquipmentTextBox" Margin="0,5,0,0"></TextBox>
        
        <StackPanel Orientation="Horizontal" Margin="0,25,0,20">
            <Button x:Name="Cancel"
                    Content="Anuluj" 
                    Height="20"
                    Margin="0,0,8,0"
                    Click="Cancel_OnClick"/>
            <Button x:Name="EditEquipmentPriceButton" 
                    Margin="0,0,10,0"
                    Content="Dodaj" 
                    Height="20"
                    Click="EditPriceOfEquipment_OnClick"/>
        </StackPanel>
        
    </StackPanel>
</Window>
