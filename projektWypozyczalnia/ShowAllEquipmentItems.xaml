<Window x:Class="projektWypozyczalnia.ShowAllEquipmentItems"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:projektWypozyczalnia"
        mc:Ignorable="d"
        Title="ShowAllEquipmentItems" Height="450" Width="800"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <Grid>
        <DataGrid x:Name="StockDataGrid" AutoGenerateColumns="False" Margin="10,10,10,50" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwa przedmiotu" Binding="{Binding EquipmentName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <Button Content="Wyjdź" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="0,0,10,10" 
                Width="40" 
                Click="ExitButton_Click"/>
    </Grid>
</Window>
