<Window x:Class="projektWypozyczalnia.PriceListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:projektWypozyczalnia"
        mc:Ignorable="d"
        Title="PriceListWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Loaded="ShowEquipmentCheckBox_Unchecked">
    <Grid>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top">
                <Button x:Name="ExitFromPriceListButton"
                        Content="Wyjdź" 
                        Margin="10,15,0,0"
                        Click="CloseButton_OnClick"/>
                <Button x:Name="AddEquipmentToStock" 
                        Content="Edytuj cennik" 
                        Margin="10,15,0,0"
                        Click="EditPriceListButton_OnClick"/>
                <CheckBox x:Name="ShowEquipmentCheckBox" 
                          Margin="10,17,0,0" 
                          Content="Pokaż osprzęt"
                          IsChecked="False"
                          Checked="ShowEquipmentCheckBox_Checked"
                          Unchecked="ShowEquipmentCheckBox_Unchecked"/>
            </StackPanel>
            
            <DataGrid x:Name="StockDataGrid" AutoGenerateColumns="False" Margin="10,50,10,10" IsReadOnly="True" CanUserResizeColumns="False" CanUserResizeRows="False" CanUserReorderColumns="False">
                    <DataGrid.Columns>
                            <DataGridTextColumn Header="Producent" Binding="{Binding Manufacturer}" Width="*"/>
                            <DataGridTextColumn Header="System szalunkowy" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Długość" Binding="{Binding Length}" Width="*"/>
                            <DataGridTextColumn Header="Szerokość" Binding="{Binding Width}" Width="*"/>
                            <DataGridTextColumn Header="Cena" Binding="{Binding ShutteringPrice}" Width="*"/>
                            <DataGridTextColumn Header="Nazwa przedmiotu" Binding="{Binding EquipmentName}" Width="*"/>
                            <DataGridTextColumn Header="Cena" Binding="{Binding EquipmentPrice}" Width="*"/>
                    </DataGrid.Columns>
            </DataGrid>
    </Grid>
</Window>
