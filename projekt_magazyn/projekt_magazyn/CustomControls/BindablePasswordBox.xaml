<UserControl x:Class="projekt_magazyn.CustomControls.BindablePasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:projekt_magazyn.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    
    <PasswordBox x:Name="passwordUser"
                             FontSize="18"
                             FontFamily="Montserrat"
                             FontWeight="Medium"
                             Foreground="Black"
                             CaretBrush="Black"
                             BorderThickness="0,0,0,1"
                             VerticalAlignment="Center"
                             Padding="30,0,0,0">
        <PasswordBox.Background>
            <ImageBrush ImageSource="/projekt_magazyn;component/Images/key-icon.png"
                                    Stretch="Uniform"
                                    AlignmentX="Left"/>

        </PasswordBox.Background>

    </PasswordBox>
</UserControl>
